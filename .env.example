# Environment variables template
# All settings use GHOS_ prefix — see IdentitySettings for all options.

# Database (PostgreSQL)
GHOS_DATABASE_URL=postgresql+asyncpg://ghos:ghos@localhost:5432/ghos_identity

# JWT — Generate RSA keys for production:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
GHOS_JWT_PRIVATE_KEY=
GHOS_JWT_PUBLIC_KEY=
GHOS_JWT_SECRET=ghos-identity-jwt-secret-change-in-production
GHOS_JWT_ALGORITHM=RS256

# Redis
GHOS_REDIS_URL=redis://localhost:6379/0

# bcrypt cost (>= 12 recommended)
GHOS_BCRYPT_ROUNDS=12

# ── ABDM (Ayushman Bharat Digital Mission) — NHA sandbox ──────────────────
# NHA developer portal (https://abdm.gov.in) par register karke milta hai.
# Jab tak set nahi, app local scaffold mode me chalti hai (koi crash nahi).
ABDM_ENABLED=false
ABDM_SANDBOX_URL=https://abdm-sandbox.abdm.gov.in
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_HIP_ID=
ABDM_HIU_ID=
ABDM_FACILITY_ID=

# ── Public base URL (patient links / QR) ──────────────────────────────────
# Permanent domain/VM IP daalein — warna links request ke host se bante hain.
APP_BASE_URL=
